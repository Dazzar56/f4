	// Используем "/" как универсальный разделитель для внутренних проверок путей,
	// чтобы избежать проблем при копировании между Windows и Linux серверами.
	if !strings.HasSuffix(realSrc, "/") && !strings.HasSuffix(realSrc, "\\") {
