func (iv *ImageView) Close() {
	// The whole screen mode is a state of the manager, not of the frame, so
	// leaving the viewer has to hand the bars back.
	iv.full = false
	vtui.FrameManager.HideBars = false
	iv.BaseFrame.Close()

